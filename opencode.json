{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "PROJECT.md",
    "ARCHITECTURE.md",
    "ROADMAP.md",
    "SECURITY.md",
    "EVALUATION.md",
    "DEVELOPMENT.md",
    "docs/PHASE_1_SPEC.md",
    "progress/CURRENT.md"
  ],
  "permission": {
    "edit": "allow",
    "bash": {
      "*": "allow",
      "rm -rf *": "ask",
      "git push*": "ask",
      "curl * | *": "ask",
      "ollama pull*": "ask"
    }
  },
  "agent": {
    "build": {
      "permission": {
        "task": {
          "*": "allow"
        }
      }
    }
  }
}
