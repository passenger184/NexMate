# Generation provider/model — see ARCHITECTURE.md "Generation provider config".
# Any litellm-supported provider string works. Restart the service after editing.
NEXMATE_ENV=production
NEXMATE_DEV_UNAUTHENTICATED=0
NEXMATE_SERVICE_KEY=
NEXMATE_FRAPPE_SITE=

GENERATION_PROVIDER=ollama
GENERATION_MODEL=llama3.1:8b

# Only needed when GENERATION_PROVIDER=ollama.
# Points at your Windows-hosted Ollama — see DEVELOPMENT.md
# "Using Windows-hosted Ollama from WSL" for how to pick this address.
OLLAMA_BASE_URL=http://localhost:11434

# Only needed for cloud providers:
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Phase 2 code tools: the ONLY directory tree file operations may touch.
# Every path a tool receives is resolved (symlinks included) and rejected
# if it escapes this root. Defaults to this repo when unset.
# PROJECT_ROOT=/home/you/some-project

# Phase 5 read-only ERPNext API tool. Credentials stay in THIS file
# (gitignored); the client issues GET requests only.
# ERPNEXT_BASE_URL=http://localhost:8081
# ERPNEXT_API_KEY=
# ERPNEXT_API_SECRET=
